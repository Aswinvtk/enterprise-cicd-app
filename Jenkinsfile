pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Repository checked out successfully.'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'
            }
        }

        stage('Success') {
            steps {
                echo 'Enterprise CI/CD Pipeline Started Successfully!'
            }
        }
    }
}
